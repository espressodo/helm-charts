{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "espressoRepo": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "default": []
        }
      }
    },
    "espresso": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "tenant",
        "interface",
        "uiBackend",
        "scim",
        "sso"
      ],
      "properties": {
        "tenant": {
          "type": "string",
          "title": "Tenant code",
          "description": "Exactly 3 uppercase letters, e.g. ABC",
          "pattern": "^[A-Z]{3}$"
        },
        "interface": {
          "type": "string",
          "title": "Espresso interface mode",
          "enum": [
            "REST",
            "AZSB"
          ]
        },
        "workerBatchPost": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "retentionPeriodValidation": {
              "type": "string",
              "enum": [
                "",
                "disable"
              ],
              "default": ""
            }
          }
        },
        "uiFrontend": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "uiBackend": {
              "type": "string",
              "minLength": 1,
              "default": "/api/v1"
            }
          }
        },
        "uiBackend": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "existingSecret",
            "passwordSaltSecretKey",
            "privateKeySecretKey",
            "loginMode",
            "postTaskUrl"
          ],
          "properties": {
            "existingSecret": {
              "type": "string",
              "minLength": 1
            },
            "passwordSaltSecretKey": {
              "type": "string",
              "minLength": 1
            },
            "privateKeySecretKey": {
              "type": "string",
              "minLength": 1
            },
            "loginMode": {
              "type": "string",
              "enum": [
                "manual",
                "sso"
              ]
            },
            "postTaskUrl": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "scim": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "existingSecret": {
              "type": "string"
            },
            "apiTokenSecretKey": {
              "type": "string"
            }
          }
        },
        "sso": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "enabled",
            "scope"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "authorityUrl": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "clientSecretSecretKey": {
              "type": "string"
            },
            "redirectUri": {
              "type": "string"
            },
            "postLogoutRedirectUri": {
              "type": "string"
            },
            "scope": {
              "type": "string",
              "default": "openid profile email"
            }
          }
        }
      }
    },
    "db": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "postgres"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "postgres"
          ],
          "default": "postgres"
        },
        "postgres": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "host",
            "port",
            "database",
            "user",
            "sslMode",
            "existingSecret",
            "passwordSecretKey"
          ],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 5432
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "user": {
              "type": "string",
              "minLength": 1
            },
            "sslMode": {
              "type": "string",
              "default": "require",
              "enum": [
                "disable",
                "allow",
                "prefer",
                "require",
                "verify-ca",
                "verify-full"
              ]
            },
            "existingSecret": {
              "type": "string",
              "minLength": 1
            },
            "passwordSecretKey": {
              "type": "string",
              "minLength": 1
            },
            "sslRootCert": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "enabled",
                "existingSecret",
                "secretKey",
                "mountPath",
                "fileName"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                },
                "existingSecret": {
                  "type": "string"
                },
                "secretKey": {
                  "type": "string",
                  "minLength": 1,
                  "default": "ca.crt"
                },
                "mountPath": {
                  "type": "string",
                  "minLength": 1,
                  "default": "/etc/espresso/postgres-trust"
                },
                "fileName": {
                  "type": "string",
                  "minLength": 1,
                  "default": "ca.crt"
                }
              }
            }
          }
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "default": 7233
        },
        "tls": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "enabled",
            "serverName",
            "ca"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "serverName": {
              "type": "string",
              "default": ""
            },
            "ca": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "existingSecret",
                "secretKey",
                "mountPath",
                "fileName"
              ],
              "properties": {
                "existingSecret": {
                  "type": "string"
                },
                "secretKey": {
                  "type": "string",
                  "minLength": 1,
                  "default": "ca.crt"
                },
                "mountPath": {
                  "type": "string",
                  "minLength": 1,
                  "default": "/etc/espresso/trust"
                },
                "fileName": {
                  "type": "string",
                  "minLength": 1,
                  "default": "ca.crt"
                }
              }
            }
          }
        },
        "kubernetesNamespace": {
          "type": "string",
          "default": ""
        }
      }
    },
    "azsb": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "host": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "passwordSecretKey": {
          "type": "string"
        },
        "topic": {
          "type": "object",
          "properties": {
            "order": {
              "type": "string"
            }
          }
        },
        "queue": {
          "type": "object",
          "properties": {
            "delivery": {
              "type": "string"
            },
            "receipt": {
              "type": "string"
            }
          }
        }
      }
    },
    "init": {
      "type": "object",
      "required": [
        "enabled",
        "postgresSchema",
        "temporalNamespace"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "postgresSchema": {
          "type": "boolean",
          "default": true
        },
        "temporalNamespace": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled",
        "className",
        "host",
        "annotations"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "className": {
          "type": "string",
          "default": "nginx"
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "gateway": {
      "type": "object",
      "required": [
        "enabled",
        "name",
        "namespace",
        "sectionName",
        "host",
        "annotations"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string",
          "default": ""
        },
        "sectionName": {
          "type": "string",
          "default": ""
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "parentRefs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "name"
            ],
            "properties": {
              "group": {
                "type": "string",
                "default": "gateway.networking.k8s.io"
              },
              "kind": {
                "type": "string",
                "default": "Gateway"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "default": ""
              },
              "sectionName": {
                "type": "string",
                "default": ""
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "db"
        ],
        "properties": {
          "db": {
            "required": [
              "postgres"
            ],
            "properties": {
              "postgres": {
                "required": [
                  "sslMode"
                ],
                "properties": {
                  "sslMode": {
                    "enum": [
                      "verify-ca",
                      "verify-full"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "db": {
            "properties": {
              "postgres": {
                "properties": {
                  "sslRootCert": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    }
                  }
                },
                "required": [
                  "sslRootCert"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "db"
        ],
        "properties": {
          "db": {
            "required": [
              "postgres"
            ],
            "properties": {
              "postgres": {
                "required": [
                  "sslRootCert"
                ],
                "properties": {
                  "sslRootCert": {
                    "required": [
                      "enabled"
                    ],
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "db": {
            "properties": {
              "postgres": {
                "properties": {
                  "sslRootCert": {
                    "required": [
                      "existingSecret",
                      "secretKey",
                      "mountPath",
                      "fileName"
                    ],
                    "properties": {
                      "existingSecret": {
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "temporal"
        ],
        "properties": {
          "temporal": {
            "required": [
              "tls"
            ],
            "properties": {
              "tls": {
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "temporal": {
            "properties": {
              "tls": {
                "properties": {
                  "ca": {
                    "properties": {
                      "existingSecret": {
                        "minLength": 1
                      }
                    },
                    "required": [
                      "existingSecret",
                      "secretKey",
                      "mountPath",
                      "fileName"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "espresso": {
            "properties": {
              "scim": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "espresso": {
            "properties": {
              "scim": {
                "required": [
                  "existingSecret",
                  "apiTokenSecretKey"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "espresso": {
            "properties": {
              "sso": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "espresso": {
            "properties": {
              "sso": {
                "required": [
                  "authorityUrl",
                  "clientId",
                  "existingSecret",
                  "clientSecretSecretKey",
                  "redirectUri",
                  "postLogoutRedirectUri",
                  "scope"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "espresso": {
            "properties": {
              "interface": {
                "const": "AZSB"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "azsb"
        ],
        "properties": {
          "azsb": {
            "required": [
              "host",
              "user",
              "existingSecret",
              "passwordSecretKey",
              "topic",
              "queue"
            ],
            "properties": {
              "host": {
                "minLength": 1
              },
              "user": {
                "minLength": 1
              },
              "existingSecret": {
                "minLength": 1
              },
              "passwordSecretKey": {
                "minLength": 1
              },
              "topic": {
                "properties": {
                  "order": {
                    "minLength": 1
                  }
                },
                "required": [
                  "order"
                ]
              },
              "queue": {
                "properties": {
                  "delivery": {
                    "minLength": 1
                  },
                  "receipt": {
                    "minLength": 1
                  }
                },
                "required": [
                  "delivery",
                  "receipt"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gateway": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "gateway": {
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              }
            },
            "anyOf": [
              {
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name"
                ]
              },
              {
                "properties": {
                  "parentRefs": {
                    "type": "array",
                    "minItems": 1
                  }
                },
                "required": [
                  "parentRefs"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "gateway": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "not": {}
      }
    }
  ]
}
